{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-write=.,/tmp --allow-env --allow-run=ffmpeg,ffprobe,deno --allow-sys server.ts serve",
    "prod": "deno run --allow-net --allow-read --allow-write=.,/tmp --allow-env --allow-run=ffmpeg,ffprobe,deno --allow-sys server.ts serve",
    "start": "deno run --allow-net --allow-read --allow-write=.,/tmp --allow-env --allow-run=ffmpeg,ffprobe,deno --allow-sys server.ts serve"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any", "no-unused-vars", "require-await"]
    }
  },
  "unstable": [
    "sloppy-imports"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@/": "./app/",
    "#/": "./",
    "@myceliasdk/": "../myceliasdk/",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.0.0-rc.7",
    "@needle-di/core": "jsr:@needle-di/core@^1.0.0",
    "@std/async": "jsr:@std/async@^1.0.8",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/expect": "jsr:@std/expect@^1.0.16",
    "@std/fs": "jsr:@std/fs@^1.0.4",
    "@std/io": "jsr:@std/io@^0.225.2",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/net": "jsr:@std/net@^1.0.4",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.14",
    "@std/uuid": "jsr:@std/uuid@^1.0.5",
    "ms": "npm:ms",
    "bullmq": "npm:bullmq@^5.1.1",
    "formdata-node": "npm:formdata-node@^6.0.0",
    "yaml": "jsr:@std/yaml@^1.0.10",
    "bson": "npm:bson@^6.10.4",
    "zod": "npm:zod@^4.1.12"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.ns"
    ],
    "types": [],
    "strict": true
  }
}
