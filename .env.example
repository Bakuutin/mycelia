# Hugging Face Token (Required for Diarization models)
# Get one at: https://huggingface.co/settings/tokens
# Must accept terms for:
# - https://huggingface.co/pyannote/speaker-diarization-3.1
# - https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Compute Configuration
# 'gpu' or 'cpu-only'. Auto-detected by start script if not set.
# COMPUTE_MODE=gpu

# API Keys (Optional)
# API_KEY=your_secure_api_key

# Ports
OLLAMA_PORT=11434
WHISPER_PORT=8081
DIARIZATION_PORT=8085

# Ollama Configuration
# Comma separated list of models to pull
OLLAMA_MODELS=qwen2.5:7b

# Internal - Docker Specific
SPEAKER_SERVICE_PORT=8085
SPEAKER_SERVICE_HOST=0.0.0.0
