MYCELIA_URL=http://localhost:5173
MYCELIA_FRONTEND_HOST=http://localhost:3001
NGINX_PORT=4433

# Frontend Docker Mode
# Use "./frontend/Dockerfile" for production (default - nginx serving static build)
# Use "./frontend/Dockerfile.dev" for development (Vite dev server with hot reload)
FRONTEND_DOCKERFILE=./frontend/Dockerfile

# Get these from the Setup page (https://localhost:4433/setup) by clicking "Create New Credentials"
# Or run: docker compose run --rm backend deno run -A server.ts token-create
MYCELIA_CLIENT_ID=111111111111111111111111
MYCELIA_TOKEN=mycelia_1111111111111111111111111111111111111111

# generate a random secret key with `openssl rand -hex 32`
SECRET_KEY=change-me-please

DATABASE_NAME=mycelia

# IMPORTANT: REDIS_PASSWORD must match the value in ../.env (root directory)
# Docker Compose reads from root .env file
REDIS_PASSWORD=password

# Database Volume Paths
# Leave unset to use Docker named volumes (default)
# To use custom paths, uncomment and set these variables:
# MONGO_HOST_PATH=~/.mycelia/data/mongo
# REDIS_HOST_PATH=~/.mycelia/data/redis


# MongoDB Configuration
MONGO_URL=mongodb://mongo:27017?directConnection=true
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# OpenTelemetry Configuration
OTEL_DENO=false
OTEL_SERVICE_NAME=mycelia
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Application Configuration
LOG_LEVEL=INFO
NODE_ENV=development

# Job Queue Configuration (TEST/DEBUG ONLY)
# Enable fast mode for job triggers (reduces debounce/interval for testing)
# WARNING: Do not enable in production - uses aggressive timing for testing
# JOB_TRIGGERS_FAST=true

# Override job debounce time in milliseconds (TEST/DEBUG ONLY)
# JOB_DEBOUNCE_MS=

# Override job interval in seconds (TEST/DEBUG ONLY)
# JOB_INTERVAL_SECONDS=

# Transcription Configuration
# Language code for transcription (default: "auto")
# Set this to prevent faster-whisper language detection failures with short audio
# TRANSCRIPTION_LANGUAGE=auto

# Model Configuration
# BASE_MODEL: Override model for all requests (highest priority)
# BASE_MODEL=gpt-4o

# Model Alias Configuration
# Map model size aliases (small/medium/large) to actual model names
# Only used when NOT using inference.mycelia.tech (which handles aliases itself)
# If not set, aliases default to BASE_MODEL, then to hardcoded defaults
# MODEL_SMALL=gpt-4o-mini
# MODEL_MEDIUM=gpt-4o
# MODEL_LARGE=gpt-4o
