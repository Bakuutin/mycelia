MYCELIA_URL=http://localhost:5173
MYCELIA_FRONTEND_HOST=http://localhost:3001

# run `docker compose run --rm backend deno run -A server.ts token-create` command to get these values
MYCELIA_TOKEN=mycelia_1111111111111111111111111111111111111111
MYCELIA_CLIENT_ID=111111111111111111111111

# generate a random secret key with `openssl rand -hex 32`
SECRET_KEY=change-me-please-use-openssl-rand-hex-32

DATABASE_NAME=mycelia

# IMPORTANT: REDIS_PASSWORD must match the value in ../.env (root directory)
# Docker Compose reads from root .env file
REDIS_PASSWORD=password

# MongoDB Configuration
MONGO_URL=mongodb://mongo:27017?directConnection=true
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# OpenTelemetry Configuration
OTEL_DENO=false
OTEL_SERVICE_NAME=mycelia
OTEL_SERVICE_VERSION=1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Application Configuration
LOG_LEVEL=INFO
NODE_ENV=development

# Audio Import Configuration (Python daemon)
# Paths are auto-detected on macOS. Override only if needed.
# MYCELIA_APPLE_VOICEMEMOS_ROOT=~/Library/Group Containers/group.com.apple.VoiceMemos.shared/Recordings
# MYCELIA_GOOGLE_DRIVE_ROOT=~/Library/CloudStorage/GoogleDrive-YOUR_EMAIL/My Drive/Easy Voice Recorder
# MYCELIA_LOCAL_AUDIO_ROOT=~/Library/mycelia/audio
MYCELIA_GOOGLE_TZ=Europe/Amsterdam
MYCELIA_LOCAL_TZ=Europe/Amsterdam
DIARIZATION_SERVER_URL=http://localhost:8085