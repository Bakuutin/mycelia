# Mycelia Root Environment Configuration
# Copy this file to .env: cp .env.example .env

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password

# Redis Configuration
REDIS_PASSWORD=password

# Backend URL (for Python services)
MYCELIA_URL=http://localhost:5173

# API Credentials (copy from backend console on first run)
# These are needed by Python services (daemon, stt, worker_server)
MYCELIA_CLIENT_ID=
MYCELIA_TOKEN=
