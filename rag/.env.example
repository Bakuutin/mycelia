# Read-only source. This service never writes to MongoDB.
RAG_MONGO_URL=mongodb://mongo:27017/?replicaSet=rs0&readPreference=primaryPreferred
RAG_MONGO_DATABASE=mycelia
RAG_REQUIRE_READONLY_MONGO=false

# Qdrant and local durable control-plane state.
RAG_QDRANT_URL=http://qdrant:6333
RAG_STATE_PATH=/data/rag-state.sqlite3
RAG_COLLECTION_PREFIX=mycelia_rag

# Stage 1 local inference profile. These explicit inference values are immutable
# for this profile. A different model contract needs a new versioned profile;
# chunking remains a separate part of projection compatibility.
RAG_MODEL_CACHE=/models
RAG_INFERENCE_PROFILE=fastembed-minilm-bm25-v1
RAG_FASTEMBED_VERSION=0.8.0
RAG_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_DENSE_ARTIFACT_REPO=qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
RAG_DENSE_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
RAG_DENSE_TOKENIZER=qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
RAG_DENSE_TOKENIZER_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
RAG_DENSE_DOCUMENT_INSTRUCTION_ID=none
RAG_DENSE_QUERY_INSTRUCTION_ID=none
RAG_DENSE_DIMENSIONS=384
RAG_DENSE_NORMALIZATION=l2
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_SPARSE_ARTIFACT_REPO=Qdrant/bm25
RAG_SPARSE_REVISION=22b8d2af71a76161e18dd432d2cee0eefa66e412
RAG_SPARSE_TOKENIZER=fastembed-bm25-tokenization
RAG_SPARSE_TOKENIZER_REVISION=fastembed-0.8.0
RAG_SPARSE_DOCUMENT_INSTRUCTION_ID=none
RAG_SPARSE_QUERY_INSTRUCTION_ID=none
RAG_SPARSE_NORMALIZATION=none
# Independent query-time stage: disabled and not part of the vector projection.
RAG_RERANKER_ENABLED=false

# Current deployment has no end-user auth. Set both values for service-to-service auth.
RAG_AUTH_MODE=none
RAG_INTERNAL_TOKEN=

# Background incremental indexing and correctness reconciliation.
RAG_ENABLE_BACKGROUND=true
RAG_RECONCILE_INTERVAL_SECONDS=900
RAG_CHANGE_STREAM_RETRY_SECONDS=5
RAG_BATCH_SIZE=64
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160
