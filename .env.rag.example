# Standalone Qdrant/RAG stack. Copy to `.env.rag.local` and pass it with
# `docker compose --env-file .env.rag.local -f docker-compose.rag.yml ...`.

# This Compose project is independent from the main Mycelia stack.
RAG_COMPOSE_PROJECT_NAME=mycelia-rag
RAG_IMAGE_TAG=dev

# Host-only ports. They do not overlap Mycelia's 4433/3210 or MongoDB's 27017.
RAG_API_BIND=127.0.0.1
RAG_API_PORT=48091
RAG_QDRANT_BIND=127.0.0.1
RAG_QDRANT_HTTP_PORT=46333
RAG_QDRANT_GRPC_PORT=46334

# The standalone stack reads the canonical MongoDB exposed by the main stack.
# Add credentials and authSource here only when the current Mongo deployment
# requires them. The planned read-only database-user migration will replace
# this transitional connection contract.
RAG_MONGO_URL=mongodb://host.docker.internal:27017/?directConnection=true
RAG_MONGO_DATABASE=mycelia

# Stage 1 embedding profile. The explicit model/tokenizer/instruction/output
# values below are immutable for this profile and are rejected if changed. Add
# a new versioned profile and blue/green rebuild for Qwen or any different
# embedding contract; never repoint this profile in place.
RAG_INFERENCE_PROFILE=fastembed-minilm-bm25-v1
RAG_FASTEMBED_VERSION=0.8.0
RAG_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_DENSE_ARTIFACT_REPO=qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
RAG_DENSE_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
RAG_DENSE_TOKENIZER=qdrant/paraphrase-multilingual-MiniLM-L12-v2-onnx-Q
RAG_DENSE_TOKENIZER_REVISION=faf4aa4225822f3bc6376869cb1164e8e3feedd0
RAG_DENSE_DOCUMENT_INSTRUCTION_ID=none
RAG_DENSE_QUERY_INSTRUCTION_ID=none
RAG_DENSE_DIMENSIONS=384
RAG_DENSE_NORMALIZATION=l2
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_SPARSE_ARTIFACT_REPO=Qdrant/bm25
RAG_SPARSE_REVISION=22b8d2af71a76161e18dd432d2cee0eefa66e412
RAG_SPARSE_TOKENIZER=fastembed-bm25-tokenization
RAG_SPARSE_TOKENIZER_REVISION=fastembed-0.8.0
RAG_SPARSE_DOCUMENT_INSTRUCTION_ID=none
RAG_SPARSE_QUERY_INSTRUCTION_ID=none
RAG_SPARSE_NORMALIZATION=none
# Independent query-time stage: disabled and not part of the vector projection.
RAG_RERANKER_ENABLED=false
RAG_COLLECTION_PREFIX=mycelia_rag

# Incremental indexing and bounded reconciliation controls.
RAG_ENABLE_BACKGROUND=true
RAG_RECONCILE_INTERVAL_SECONDS=900
RAG_CHANGE_STREAM_RETRY_SECONDS=5
RAG_BATCH_SIZE=64
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=160

# Transitional single-user mode. A later migration will switch these to
# owner-scoped authorization plus a dedicated read-only MongoDB account.
# The loopback-only default may use `none`. If RAG_API_BIND is changed to
# 0.0.0.0, change this to `internal_token`, generate a strong token below, and
# copy the same token to the main backend's ignored `.env`.
RAG_AUTH_MODE=none
RAG_INTERNAL_TOKEN=
RAG_REQUIRE_READONLY_MONGO=false
