# Development Dockerfile - watches and rebuilds with hot reload
FROM denoland/deno:2.6.3

ENV DENO_DIR=/deno-dir
ENV NODE_ENV=development

WORKDIR /app

# Copy lockfiles and config first for better caching
COPY ./frontend/deno.json ./frontend/deno.lock ./frontend/package.json ./frontend/package-lock.json ./

# Pre-resolve npm packages Vite needs into node_modules via Deno
RUN deno cache --node-modules-dir --lock=deno.lock --reload npm:vite

# Copy interfaces for import resolution
COPY ./interfaces ./interfaces

# Source files will be mounted as a volume for hot reload
# COPY ./frontend .  # Not needed - volume mount in docker-compose

EXPOSE 8080

# Run dev server on port 8080 with host binding for Docker
CMD ["deno", "run", "--watch", "-A", "npm:vite", "--host", "0.0.0.0", "--port", "8080"]

