server {
    # Runtime hostname resolution uses whatever DNS the container runtime gave
    # us (Docker's 127.0.0.11, Podman's own, ...), read from /etc/resolv.conf by
    # the entrypoint. Do not hardcode a list: nginx round-robins across the
    # servers instead of failing over, so one unreachable address stalls every
    # request that lands on it for the full 5s DNS resend interval.
    resolver ${NGINX_RESOLVER} ipv6=off valid=30s;
    listen 80 default_server;
    listen 443 ssl http2 default_server;
    listen 4433 ssl http2 default_server;

    server_name _;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Minimal sane defaults for SSL
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Allow larger uploads (voice samples, audio files)
    client_max_body_size 50M;

    # Variables for upstream hosts (forces runtime DNS resolution)
    set $frontend_upstream "http://frontend:8080";
    set $backend_upstream "http://backend:5173";

    # Backend routes
    location ~ ^/(ws|api|data|oauth|llm|v1|mcp|health|readiness|\.well-known) {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Everything else to frontend
    location / {
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
