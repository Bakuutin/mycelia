# Mycelia Remote Deployment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# HUGGING FACE (Required for Diarization)
# ===========================================
# Get your token from: https://huggingface.co/settings/tokens
# You must also accept model terms at:
# - https://huggingface.co/pyannote/speaker-diarization-3.1
# - https://huggingface.co/pyannote/segmentation-3.0
# - https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# OLLAMA
# ===========================================
# Models to pull on startup (comma-separated)
# Presets:
#   tiny:   llama3.2:3b           (4GB)
#   small:  qwen2.5:7b            (8GB)
#   medium: llama3.3:70b-instruct-q4_K_M (16GB)
#   large:  llama3.3:70b          (32GB)
#   xlarge: llama4:scout          (48GB+)
OLLAMA_MODELS=qwen2.5:7b

# Port to expose Ollama API
OLLAMA_PORT=11434

# ===========================================
# WHISPER (Speech-to-Text)
# ===========================================
# Port to expose Whisper API
WHISPER_PORT=8081

# Optional: API key for authentication (leave empty to disable)
API_KEY=

# ===========================================
# DIARIZATION (Speaker Recognition)
# ===========================================
# Port to expose Diarization API
DIARIZATION_PORT=8085

# PyTorch CUDA version (cu121, cu126, cu128, or cpu)
PYTORCH_CUDA_VERSION=cu121
