# ==============================================================================
# GPU SERVICES CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the required values

# ==============================================================================
# PROXY SERVER (Whisper + Ollama)
# ==============================================================================

# PROXY_API_KEY - Authentication key for the proxy server
# Used by: gpu/proxy/server.py
# Purpose: Bearer token authentication for Whisper/Ollama API access
# Generate: openssl rand -hex 32
# PROXY_API_KEY=your_secret_api_key_here

# PROXY_PORT - Port for the proxy server (default: 8000)
# PROXY_PORT=8000

# ==============================================================================
# DIARIZATION SERVICE (Speaker Recognition)
# ==============================================================================

# HF_TOKEN - Hugging Face access token (REQUIRED for diarization)
# Used by: diarization service to download PyAnnote models
# Get your token: https://huggingface.co/settings/tokens
#
# IMPORTANT: You must accept the terms for these models:
#   - https://huggingface.co/pyannote/speaker-diarization-3.1
#   - https://huggingface.co/pyannote/segmentation-3.0
#   - https://huggingface.co/pyannote/wespeaker-voxceleb-resnet34-LM
#
HF_TOKEN=hf_your_token_here

# ==============================================================================
# WHISPER ASR
# ==============================================================================

# ASR_MODEL - Whisper model to use
# Options: tiny, base, small, medium, large, large-v2, large-v3, large-v3-turbo
# Default: large-v3-turbo (best quality/speed balance)
# ASR_MODEL=large-v3-turbo

# ==============================================================================
# NETWORK ACCESS
# ==============================================================================
#
# Services are exposed on these ports:
#   - Proxy (Whisper + Ollama): 8000
#   - Diarization: 8085
#
# For remote access, use one of:
#   1. Tailscale VPN (recommended): Install Tailscale and use Tailscale IP
#   2. SSH tunnel: ssh -L 8000:localhost:8000 -L 8085:localhost:8085 user@gpu-machine
#   3. Firewall rules: Open ports 8000 and 8085 (less secure)
#