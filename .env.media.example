# Copy to .env.media.local. Use absolute host paths; Compose does not expand ~.
FRONTEND_MODE=dev
BACKEND_TASK=dev
MYCELIA_URL=https://localhost:4443
MYCELIA_FRONTEND_HOST=https://localhost:4443
ALLOW_INSECURE_TRANSPORT=false

# Dedicated development-only values. Replace them in .env.media.local.
SECRET_KEY=replace-with-a-long-random-development-secret
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-random-mongo-password
MONGO_URL=mongodb://mongo:27017?directConnection=true
DATABASE_NAME=mycelia_media_89da
REDIS_PASSWORD=replace-with-a-random-redis-password

# Read-only originals. The GCP path is only used by the optional GCP overlay.
# Both must be absolute paths; Compose does not expand ~.
MEDIA_SOURCE_HOST_PATH=/absolute/path/to/media-import-test-data
GCP_ADC_HOST_PATH=/absolute/path/to/application_default_credentials.json

# Optional future self-hosted Open Media API bearer token.
MEDIA_SELF_HOSTED_API_KEY=
